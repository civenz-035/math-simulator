# ============================================================
# 💎 FUSION BOT v4.1 — DEDICATED CONFIGURATION (fusion.env)
# Architecture: Single Source of Truth (SSOT)
# Used by:
#   - bin/fusion_bot.py            (Python Simulator / Roll Engine)
#   - bin/fusion_bot_gamblerbot.py (Gambler.Bot IronPython Edition)
#   - bin/fusion_live_hud.py       (Real-Time ANSI Dashboard)
# ============================================================

# ── [1] Core Environment & Bankroll ─────────────────────────
START_BALANCE=20   # เงินทุนเริ่มต้น (Bankroll)
HE=1.0                      # House Edge ของคาสิโน (%) Stake Dice = 1.0%
GLOBAL_MAX_ROUNDS=200000    # จำนวนรอบสูงสุดที่จำลอง (Rounds cap)
GLOBAL_ROUND_DELAY=0.05     # หน่วงเวลาระหว่างรอบใน Simulator (วินาที)

# ── [2] Strategy Selector ───────────────────────────────────
# 1 = WAGER FOCUS + RECOVERY (ปั่น Wager พอโดน Cut Loss สลับไป Martingale กู้ทุนคืน)
# 2 = PROFIT FOCUS (Martingale เน้นทำกำไรล้วน)
FUSION_MAIN_MODE=1

# ── [3] Wager Mode Settings ─────────────────────────────────
FUSION_WAGER_CHANCE=98.0    # โอกาสชนะตอนปั่น Wager (%) [แนะนำ 95 - 98%]
FUSION_WAGER_BET_PCT=2.5    # % ของ Balance สำหรับเบทไม้ปั่น Wager
FUSION_WAGER_TARGET=100.0  # เป้า Turnover รวม (Wager volume target)
FUSION_ENABLE_WAGER_TARGET=1 # 1 = เปิดหยุดเมื่อถึงเป้า Wager, 0 = ปิด

# ── [4] Loss Cut & Recovery Engine ──────────────────────────
FUSION_LOSS_CUT_PCT=4.0     # ขาดทุนสะสม % จากยอดตั้งต้น Wager Cycle → ตัดขาดทุนเข้าโหมดกู้ทุน
FUSION_RECOVER_PROFIT_PCT=1.0 # กำไรเป้าหมายตอนกู้ทุน (สูตร: ยอดที่เสีย + Balance*N%)

# ── [5] Profit / Recovery Mode & Auto-Chance ────────────────
FUSION_AUTO_CHANCE=1        # 1 = สุ่ม Chance ทุกตา/ทุกรอบ, 0 = ใช้ค่าคงที่
FUSION_CHANCE_MIN=30.0      # ขอบเขต Chance ต่ำสุด (%)
FUSION_CHANCE_MAX=40.0      # ขอบเขต Chance สูงสุด (%)
FUSION_CHANCE_FIXED=0.5     # Chance คงที่ (ใช้เมื่อ FUSION_AUTO_CHANCE=0)
FUSION_RANDOM_ON_WIN=1      # สุ่ม Chance ใหม่เมื่อชนะ (1 = เปิด, 0 = ปิด)
FUSION_RANDOM_ON_LOSE=0     # สุ่ม Chance ใหม่เมื่อแพ้ (1 = เปิด, 0 = ปิด)

# ── [6] Multiplier & Risk Engine ────────────────────────────
FUSION_RISK_BONUS_PCT=10.0      # % ตัวคูณโบนัสเพิ่มเข้าไปใน Multiplier (เพิ่มความเร็วการทบ)
AUTO_CAL_ALLOWED_LOSS=1         # 1 = คำนวณ Allowed Losses (N) อัตโนมัติตาม Chance, 0 = ใช้ค่า FUSION_ALLOWED_LOSSES
FUSION_RISK_ALPHA=0.001         # ระดับความเสี่ยงแตกที่ยอมรับได้ (0.001 = 0.1% หรือ 1 ใน 1,000, 0.0001 = 0.01%)
FUSION_ALLOWED_LOSSES=14        # จำนวน Loss คงที่ก่อน reset base (ใช้เมื่อ AUTO_CAL_ALLOWED_LOSS=0)
FUSION_MIN_BET=0.00000001       # ขนาดเบทต่ำสุดของระบบ (Minimum bet limit)

# ── [7] Global Safety Caps (Stop Rules) ─────────────────────
FUSION_STOP_PROFIT=0.2      # สัดส่วนกำไรถึงยอดนี้แล้วหยุด (0.2 = +20% ROI, 0 = ปิด)
FUSION_STOP_LOSS=0.0        # สัดส่วนขาดทุนถึงยอดนี้แล้วหยุด (เช่น 0.5 = -50%, 0 = ปิด)
FUSION_STOP_LOSS_STREAK=0   # แพ้ติดต่อกัน N ไม้แล้วหยุด (0 = ไม่จำกัด)

