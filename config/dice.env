# ============================================================
# DICE SIMULATOR - CENTRAL CONFIGURATION (dice.env)
# Architecture: Single Source of Truth (SSOT)
# ============================================================

# ============================================================
# [0] GLOBAL DEFAULTS (shared defaults - used by every model unless overridden)
# ============================================================
GAME_MODE=3                     # 1=Profit, 2=Wager, 3=Hybrid, 4=Custom, 5=Brave
START_BALANCE=10.00000000    # เงินทุนเริ่มต้น
HE=1.0                          # House Edge (%)

GLOBAL_BASE_BET=0.61038882      # เบทเริ่มต้นกลาง
GLOBAL_WIN_CHANCE=3.96          # โอกาสชนะกลาง (%)
GLOBAL_BET_TARGET=high          # ทิศทางการแทงกลาง (high หรือ low)
GLOBAL_MAX_ROUNDS=200000        # จำนวนรอบสูงสุดที่จำลอง
GLOBAL_ROUND_DELAY=0.05         # หน่วงเวลาระหว่างรอบ (วินาที)

# Global Safety Caps (0 = ปิด / ไม่จำกัด)
GLOBAL_STOP_PROFIT=0.00000000   # กำไรสุทธิถึงยอดนี้แล้วหยุด (จำนวนเงิน)
GLOBAL_STOP_LOSS=0.00000000     # ขาดทุนสุทธิถึงยอดนี้แล้วหยุด
GLOBAL_STOP_ON_WIN=0            # ชนะสะสมครบ N ครั้งแล้วหยุด
GLOBAL_MAX_LOSS_STREAK=0        # แดงติดกัน N ไม้แล้วหยุด (0 = ไม่จำกัด)
HUNT_RARE=0                     # 1 = เปิดโหมดล่า Rare Number (990x-9900x), 0 = ปิด

# ============================================================
# [MODE 1: ESCALATION (multiplier recovery after consecutive losses)]
# ============================================================
PROFIT_BASE_BET=0.0025      # ถ้าปล่อยว่าง จะใช้ GLOBAL_BASE_BET
PROFIT_WIN_CHANCE=0.36          # โอกาสชนะ (%)
PROFIT_BET_TARGET=high          # high หรือ low
PROFIT_STOP_TARGET=1.00000000 # เป้ากำไรของโหมด Profit
PROFIT_MAX_LOSS_STREAK=20000      # จำกัด Streak แพ้เฉพาะของ Martingale
PROFIT_STOP_ON_WIN=50000        # ชนะครบ N ครั้งแล้วหยุด

# ============================================================
# [MODE 2: HIGH-FREQUENCY (flat stake, high win probability)]
# ============================================================
WAGER_BASE_BET=                 # ถ้าปล่อยว่าง จะคำนวณจาก WAGER_BET_PCT
WAGER_BET_PCT=3               # % ของทุนเริ่มต้นสำหรับเบทปั่น (เช่น 2.5%)
WAGER_WIN_CHANCE=98.00          # โอกาสชนะสูงเพื่อปั่นรอบ
WAGER_BET_TARGET=high           # high หรือ low
WAGER_TARGET=1000.00         # เป้าหมายยอดเทิร์นโอเวอร์ (เฉพาะโหมด 2 และ 3)
WAGER_STOP_ON_WIN=50000

# ============================================================
# [MODE 3: DUAL-STRATEGY (switches between the two above)]
# ============================================================
HYBRID_LOSS_TRIGGER=2.0         # ทุนลดลง -2% สลับไปกู้ทุน (PROFIT MODE)
HYBRID_PROFIT_TRIGGER=5       # กู้ทุนเกิน +1% ดึงกำไรเข้า Vault แล้วกลับมา WAGER

# ============================================================
# [MODE 4: CONFIGURABLE MODEL]
# ============================================================
# พื้นฐานของ Custom (ถ้าปล่อยว่าง จะใช้ GLOBAL_xxx)
CUSTOM_BASE_BET=0.61038882
CUSTOM_WIN_CHANCE=3.96
CUSTOM_BET_TARGET=high

# Multiplier Settings (On Loss)
CUSTOM_LOSS_MUL=1.06
CUSTOM_LOSS_MUL_EVERY=1
CUSTOM_LOSS_RESET_FIRST=0
CUSTOM_LOSS_CHANGE_BET_STREAK=0
CUSTOM_LOSS_CHANGE_BET_VALUE=0.00000000
CUSTOM_LOSS_CHANGE_CHANCE_STREAK=0
CUSTOM_LOSS_CHANGE_CHANCE_VALUE=0.00

# On Win Settings
CUSTOM_WIN_MUL=1.00
CUSTOM_WIN_RESET_BASE=5

# Reset Bet Triggers (0 = disabled)
CUSTOM_RESET_AFTER_BETS=0
CUSTOM_RESET_ON_LOSS_STREAK=0
CUSTOM_RESET_ON_LOSS_TOTAL_EVERY=0
CUSTOM_RESET_ON_LOSS_VALUE_ROW=0.00000000
CUSTOM_RESET_ON_LOSS_VALUE_TOTAL_EVERY=0.00000000
CUSTOM_RESET_ON_LOSS_SINCE_MAX_PROFIT=0.00000000

CUSTOM_RESET_ON_WIN_STREAK=1
CUSTOM_RESET_ON_WIN_TOTAL_EVERY=0
CUSTOM_RESET_ON_WIN_VALUE_ROW=0.00000000
CUSTOM_RESET_ON_WIN_VALUE_TOTAL_EVERY=0.00000000
CUSTOM_RESET_ON_WIN_SINCE_MIN_PROFIT=0.00000000

# Stop Triggers เฉพาะของ Custom เอง (0 = disabled, ไม่ปนกับ Martingale)
CUSTOM_STOP_AFTER_BETS=0
CUSTOM_STOP_ON_LOSS_STREAK=0    # 0 = ปล่อยฟรี ไม่ถูกตัดจบโดยโหมดอื่น
CUSTOM_STOP_ON_LOSS_TOTAL=0
CUSTOM_STOP_ON_LOSS_VALUE_ROW=0.00000000
CUSTOM_STOP_ON_LOSS_VALUE_TOTAL=0.00000000
CUSTOM_STOP_ON_LOSS_SINCE_MAX_PROFIT=0.00000000

CUSTOM_STOP_ON_WIN_STREAK=0
CUSTOM_STOP_ON_WIN_TOTAL=0
CUSTOM_STOP_ON_WIN_VALUE_ROW=0.00000000
CUSTOM_STOP_ON_WIN_VALUE_TOTAL=0.00000000
CUSTOM_STOP_ON_WIN_SINCE_MIN_PROFIT=0.00000000

# Custom Balance Bounds
CUSTOM_UPPER_LIMIT_BALANCE=15000.00000000
CUSTOM_LOWER_LIMIT_BALANCE=0.00000000
CUSTOM_MIN_BET=0.00000000
CUSTOM_MAX_BET=0.00000000
CUSTOM_ZIGZAG_EVERY=0
CUSTOM_BETS_PER_SEC=0.00

# ============================================================
# [MODE 5: SURVIVOR (initial stake for a given loss tolerance)]
# ============================================================
BRAVE_LOSSES_ALLOWED=14         # จุดตาย: ยอมรับให้แดงติดกันได้สูงสุดกี่ไม้ (N)
BRAVE_LOSS_MUL=2.0000             # ตัวคูณทบเมื่อแพ้ (Multiplier)
BRAVE_WIN_CHANCE=49.50           # โอกาสชนะ (%)
BRAVE_BET_TARGET=high           # high หรือ low
BRAVE_STOP_PROFIT=500.00000000  # เป้ากำไรที่รอดชีวิตแล้วหยุด (0 = ไม่จำกัด)
BRAVE_WIN_RESET_BASE=1          # ชนะแล้วรีเซ็ตกลับไม้ 1 (1 = ใช่, 0 = ทบต่อ)
